    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(124, 58, 237, 0.1) 100%);
    color: #7c3aed;
    border-color: #8b5cf6;
  }

  [data-theme="dark"] .tech-sidebar-badge:nth-child(1) {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.2) 0%, rgba(124, 58, 237, 0.15) 100%);
    color: #c4b5fd;
  }

  .tech-sidebar-badge:nth-child(2) {
    background: linear-gradient(135deg, rgba(36, 78, 90, 0.15) 0%, rgba(36, 78, 90, 0.1) 100%);
    color: #244c5a;
    border-color: #2e6273;
  }

  [data-theme="dark"] .tech-sidebar-badge:nth-child(2) {
    background: linear-gradient(135deg, rgba(36, 78, 90, 0.2) 0%, rgba(36, 78, 90, 0.15) 100%);
    color: #5ebcd1;
  }

  .tech-sidebar-badge:nth-child(3) {
    background: linear-gradient(135deg, rgba(234, 179, 8, 0.15) 0%, rgba(202, 138, 4, 0.1) 100%);
