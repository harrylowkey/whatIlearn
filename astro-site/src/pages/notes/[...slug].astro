    z-index: 10;
    text-decoration: none;
  }

  [data-theme="dark"] .tech-sidebar-badge {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.2) 0%, rgba(124, 58, 237, 0.15) 100%);
    border: 1px solid rgba(139, 92, 246, 0.4);
    color: #c4b5fd;
  }

