---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Get the slug from the URL
const { slug } = Astro.params;

// Fetch the note dynamically
const note = await getEntry('notes', slug as string);

// If note doesn't exist, return 404
if (!note) {
  return Astro.redirect('/404');
}

const { Content } = await note.render();

// Get related notes (same tags)
const allNotes = await getCollection('notes');
const relatedNotes = allNotes
  .filter(n => {
    if (n.slug === note.slug) return false;
    if (!n.data.tags || !note.data.tags) return false;
    return n.data.tags.some(tag =>
      note.data.tags.includes(tag)
    );
  })
  .sort((a, b) => {
    if (a.data.date && b.data.date) {
      return b.data.date.getTime() - a.data.date.getTime();
    }
    return 0;
  })
  .slice(0, 3);
---

<BaseLayout
  title={`${note.data.title} - Harry Dang`}
  description={note.data.description}
  fullWidth={true}
>
  <main class="magazine-layout">
    <!-- Left Sidebar: Tags -->
    {note.data.tags && note.data.tags.length > 0 && (
      <aside class="left-tech-sidebar">
        <div class="tech-sidebar-list">
          {note.data.tags.map((tag) => (
            <a href={`/notes?key=${encodeURIComponent(tag)}`} class="tech-sidebar-badge">{tag}</a>
          ))}
        </div>
      </aside>
    )}

    <!-- Right Sidebar: Related Notes -->
    {relatedNotes.length > 0 && (
      <aside class="right-related-sidebar">
        <div class="related-sidebar-content">
          <h3 class="related-sidebar-title">Related Notes</h3>
          <div class="related-sidebar-list">
            {relatedNotes.map((related) => (
              <a href={`/notes/${related.slug}`} class="related-sidebar-card">
                <div class="related-sidebar-image">
                  <div class="related-sidebar-placeholder">
                    <i class="mdi mdi-note-text"></i>
                  </div>
                </div>
                <h4 class="related-sidebar-card-title">{related.data.title}</h4>
              </a>
            ))}
          </div>
        </div>
      </aside>
    )}

    <!-- Hero Section -->
    <section class="magazine-hero">
      <a href="/notes" class="back-link">
        <i class="mdi mdi-arrow-left"></i>
        <span>All Notes</span>
      </a>

      <div class="hero-overlay">
        <div class="hero-content">
          <div class="hero-meta">
            {note.data.date && (
              <span class="date-text">
                {note.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                })}
              </span>
            )}
            <span class="views-count">
              <i class="mdi mdi-eye-outline"></i>
              <span id="view-count">0</span> views
            </span>
          </div>

          <h1 class="magazine-title">{note.data.title}</h1>

          {note.data.description && (
            <p class="magazine-subtitle">{note.data.description}</p>
          )}
        </div>
      </div>
    </section>

    <!-- Article Content -->
    <article class="magazine-article">
      <div class="article-container">
        <!-- Main Content Column -->
        <div class="article-content">
          <Content />
        </div>
      </div>
    </article>

    <!-- Footer Navigation -->
    <footer class="magazine-footer">
      <div class="footer-container">
        <a href="/notes" class="footer-cta">
          <i class="mdi mdi-view-grid"></i>
          <span>Explore More Notes</span>
        </a>
      </div>
    </footer>
  </main>
</BaseLayout>

<script define:vars={{ slug: note.slug }}>
  // Track and display view count
  async function trackView() {
    const pagePath = `notes/${slug}`;
    const apiUrl = `/api/views/${pagePath}`;

    console.log('Tracking view for:', pagePath);
    console.log('API URL:', apiUrl);

    try {
      // Increment view count
      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
      });

      console.log('Response status:', response.status);

      if (response.ok) {
        const data = await response.json();
        console.log('Response data:', data);
        const viewCountElement = document.getElementById('view-count');
        console.log('View count element:', viewCountElement);
        if (viewCountElement && data.views !== undefined) {
          viewCountElement.textContent = data.views.toLocaleString();
          console.log('Updated view count to:', data.views);
        }
      } else {
        console.error('Response not OK:', response.status, await response.text());
      }
    } catch (error) {
      console.error('Error tracking view:', error);
      // If API fails, try to get existing count
      try {
        const getResponse = await fetch(apiUrl);
        if (getResponse.ok) {
          const data = await getResponse.json();
          const viewCountElement = document.getElementById('view-count');
          if (viewCountElement && data.views !== undefined) {
            viewCountElement.textContent = data.views.toLocaleString();
          }
        }
      } catch (getError) {
        console.error('Error getting view count:', getError);
      }
    }
  }

  // Track view when page loads
  console.log('Document ready state:', document.readyState);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', trackView);
  } else {
    trackView();
  }
</script>

<style>
