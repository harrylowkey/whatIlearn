    border: 1px solid #8b5cf6;
    border-radius: 2rem;
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: 0 4px 16px rgba(139, 92, 246, 0.2);
    pointer-events: auto;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
