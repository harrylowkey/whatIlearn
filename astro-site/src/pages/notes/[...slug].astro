    position: relative;
    background: var(--color-bg);
  }

  /* Left Tech Sidebar - Flying Tags */
  .left-tech-sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100vh;
    pointer-events: none;
    z-index: 50;
    overflow: hidden;
  }

  .tech-sidebar-content {
    display: none;
  }

  .tech-sidebar-title {
    display: none;
  }

  .tech-sidebar-list {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
  }

  .tech-sidebar-badge {
