    font-size: 1.25rem;
  }

  .hero-overlay {
    position: relative;
    flex: 1;
    display: flex;
    align-items: flex-end;
    padding: 4rem 2rem;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;
    color: var(--color-text-primary);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .date-text {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }

  .views-count {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-tertiary);
    padding: 0.25rem 0.75rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
    border: 1px solid rgba(99, 102, 241, 0.2);
