---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
---

<BaseLayout
  title="Harry Dang - Backend Developer & DevOps Engineer"
  description="Backend developer specializing in scalable systems, databases, and cloud infrastructure"
  fullWidth={true}
>
  <!-- Section Navigation -->
  <SectionNav />

  <!-- Hero Section -->
  <section id="hero" class="hero-section">
    <div class="hero-content">
      <div class="hero-header-row">
        <div class="hero-avatar">
          <img src="/avatar.png" alt="Harry Dang" />
        </div>

        <div class="hero-info">
          <h2 class="hero-role">Backend Developer</h2>
          <p class="hero-tagline">Fascinated by Databases, DevOps, Neovim</p>

          <div class="hero-social">
            <a href="https://github.com/harrylowkey" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
              <i class="mdi mdi-github"></i>
            </a>
            <a href="https://www.linkedin.com/in/hong-quang-dang" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
              <i class="mdi mdi-linkedin"></i>
            </a>
            <a href="mailto:harrydang.tech@gmail.com" class="social-link" aria-label="Email">
              <i class="mdi mdi-email"></i>
            </a>
          </div>
        </div>
      </div>

      <h1 class="hero-title">
        Hi, I'm <span class="text-gradient">Harry Dang</span>
      </h1>

      <p class="hero-description">
With <span class="highlight-green">5+ years of experience</span> designing <br /> <span class="highlight-orange">scalable</span> <span class="highlight-orange">secure</span> and <span class="highlight-orange">high-performance systems</span><br />

        Experienced in <span class="highlight">microservices architecture</span><br />
        <span class="highlight">database optimization</span> and <span class="highlight">applied cryptography</span>
        Proficient in <span class="highlight">real-time systems</span> <span class="highlight">3rd-party integrations</span>
and <span class="highlight">secure deployments</span><br />

        Proven ability to deliver secure and maintainable backend architectures for <span class="highlight-alt">SaaS</span> <span class="highlight-alt">social networks</span> and
        <span class="highlight-alt">e-commerce</span> platforms.
      </p>

      <div class="hero-actions">
        <a href="/projects" class="btn-modern btn-primary btn-large">
          <i class="mdi mdi-briefcase"></i>
          <span>View My Work</span>
          <i class="mdi mdi-arrow-right"></i>
        </a>
        <a href="/notes" class="btn-modern btn-secondary btn-large">
          <i class="mdi mdi-book-open-variant"></i>
          <span>Read My Notes</span>
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <a href="/projects?tech=aws" class="floating-card card-1">
        <i class="mdi mdi-aws"></i>
        <span>AWS</span>
      </a>
      <a href="/projects?tech=python" class="floating-card card-2">
        <i class="mdi mdi-language-python"></i>
        <span>Python</span>
      </a>
      <a href="/projects?tech=microservice" class="floating-card card-3">
        <i class="mdi mdi-hexagon-multiple"></i>
        <span>Microservice</span>
      </a>
      <a href="/projects?tech=postgresql" class="floating-card card-4">
        <i class="mdi mdi-database"></i>
        <span>PostgreSQL</span>
      </a>
      <a href="/projects?tech=kubernetes" class="floating-card card-5">
        <i class="mdi mdi-kubernetes"></i>
        <span>Kubernetes</span>
      </a>
      <a href="/projects?tech=node.js" class="floating-card card-6">
        <i class="mdi mdi-nodejs"></i>
        <span>Node.js</span>
      </a>

    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="experience-section">
    <div class="section-header">
      <h2 class="section-title">Experience</h2>
      <p class="section-subtitle">Building scalable systems across companies</p>
    </div>

    <div class="experience-timeline">
      <!-- Current Role -->
      <div class="experience-item">
        <div class="experience-header">
          <div class="experience-company">
            <h3>Hodfords Vietnam</h3>
            <span class="experience-badge current">Current</span>
          </div>
          <span class="experience-period">Jul 2021 - Present</span>
        </div>

        <div class="experience-role">
          <h4>Back-end Project Lead</h4>
        </div>

        <div class="experience-projects">
          <!-- Employee Platform -->
          <div class="project-detail">
            <div class="project-header">
              <h5>Employee Platform</h5>
              <span class="project-date">Jan 2025 - Present</span>
            </div>
            <p class="project-description">
              Chat System & Secret Management + Task Management System
            </p>
            <ul class="responsibility-list">
              <li>Managed a team overseeing the collaborative efforts. Breaking, estimating and assigning tasks for team members</li>
              <li>Designed and implemented <span class="keyword-highlight">Real-time</span> <span class="keyword-highlight">E2EE</span> chat system</li>
              <li>Implemented Secure secret storage for <span class="keyword-highlight">API keys</span>, <span class="keyword-highlight">service tokens</span>, and sensitive data using <span class="keyword-highlight">E2EE</span></li>
              <li>Implemented <span class="keyword-highlight">Task management</span>, <span class="keyword-highlight">backlog hierarchy</span>, <span class="keyword-highlight">sprint automation</span>, and <span class="keyword-highlight">concurrency-safe</span> operations</li>
              <li>Designed <span class="keyword-highlight">MFA</span>, <span class="keyword-highlight">OAuth2</span>-based authorization, and comprehensive <span class="keyword-highlight">API security</span> validation across all backend microservices</li>

            </ul>
            <div class="tech-stack-mini">
              <span>Microservice</span>
              <span>GRPC</span>
              <span>Cryptography</span>
              <span>NestJS</span>
              <span>AWS</span>
              <span>Kubernetes</span>
              <span>PostgreSQL</span>
              <span>MongoDB</span>
              <span>Redis</span>
            </div>
          </div>

          <!-- Re** Project -->
          <div class="project-detail">
            <div class="project-header">
              <h5>Social Network Platform + Shopify Drop-shipping</h5>
              <span class="project-date">Nov 2022 - Jan 2025</span>
            </div>
            <p class="project-description">
              Social media application then became to drop-shipping and multi-tenant product management for B2B Enterprise
            </p>
            <ul class="responsibility-list">

              <li>Led team and working directly with clients and BA team to clarify requirements</li>
              <li>Designed <span class="keyword-highlight">database schemas</span>, <span class="keyword-highlight">indexing</span>, and <span class="keyword-highlight">caching</span>, querying strategies for <span class="keyword-highlight">high-volume transactions</span> and user data</li>
              <li>Implemented secure <span class="keyword-highlight">API endpoints</span> with <span class="keyword-highlight">JWT</span>, <span class="keyword-highlight">OAuth2</span>, and <span class="keyword-highlight">MFA</span></li>
              <li>Built reusable <span class="keyword-highlight">pip packages</span> to improve development experience across projects</li>
              <li>Orchestrated the deployment of <span class="keyword-highlight">microservices</span> and applications on <span class="keyword-highlight">AWS</span></li>
              <li>Implemented and maintained <span class="keyword-highlight">CI/CD pipelines</span> leveraging <span class="keyword-highlight">GitHub Actions</span>, <span class="keyword-highlight">ArgoCD</span>, and <span class="keyword-highlight">Kubernetes (EKS)</span></li>
              <li>Maintain the <span class="keyword-highlight">IaC</span> practices using <span class="keyword-highlight">Terraform/Helm</span>, ensuring consistent environments across staging, UAT, and production</li>
            </ul>
            <div class="tech-stack-mini">
              <span>Microservice</span>
              <span>Python</span>
              <span>FastAPI</span>
              <span>AWS</span>
              <span>Kubernetes</span>
              <span>ArgoCD</span>
              <span>PostgreSQL</span>
            </div>
          </div>

          <!-- US** Project -->
          <div class="project-detail">
            <div class="experience-role">
                <h4>Back-end Developer</h4>
            </div>
            <div class="project-header">
              <h5>Child Labor Prevention System</h5>
              <span class="project-date">Jun 2022 - Nov 2022</span>
            </div>
            <p class="project-description">
              Management web and mobile app for tracking product transactions to prevent child labor exploitation.
            </p>
            <ul class="responsibility-list">
              <li>Designed and implemented comprehensive <span class="keyword-highlight">RBAC</span> system</li>
              <li>Developed <span class="keyword-highlight">Excel importing</span> feature for <span class="keyword-highlight">bulk data processing</span></li>
              <li>Implemented <span class="keyword-highlight">APIs</span> using <span class="keyword-highlight">TypeScript</span> with focus on code quality</li>
            </ul>
            <div class="tech-stack-mini">
              <span>NestJS</span>
              <span>TypeScript</span>
              <span>Kubernetes</span>
              <span>PostgreSQL</span>
            </div>
          </div>

          <!-- Ma** & Cl** Projects -->
          <div class="project-detail collapsed">
            <div class="experience-role">
                <h4>Back-end Developer</h4>
            </div>
            <div class="project-header">
              <h5>Profile Management & CO2 Emissions Service</h5>
              <span class="project-date">Jul 2021 - Jun 2022</span>
            </div>
            <p class="project-description">
              Microservices ecosystem including profile management and CO2 emissions calculation services.
            </p>
            <ul class="responsibility-list">
              <li>Developed and maintained <span class="keyword-highlight">npm packages</span> to streamline development processes</li>
              <li>Implemented <span class="keyword-highlight">microservices</span> using <span class="keyword-highlight">Kafka</span> for <span class="keyword-highlight">inter-service communication</span></li>
              <li>Built <span class="keyword-highlight">data crawling system</span> from third-party databases</li>
            </ul>
            <div class="tech-stack-mini">
              <span>NestJS</span>
              <span>Microservice</span>
              <span>Kafka</span>
              <span>Kubernetes</span>
              <span>PostgreSQL</span>
              <span>Redis</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Corize Vietnam -->
      <div class="experience-item">
        <div class="experience-header">
          <div class="experience-company">
            <h3>Corize Vietnam Inc.</h3>
          </div>
          <span class="experience-period">Jun 2020 - Jun 2021</span>
        </div>

        <div class="experience-role">
          <h4>Junior Back-end Developer</h4>
        </div>

        <div class="experience-projects">
          <div class="project-detail">
            <div class="project-header">
              <h5>Japanese HR Management System</h5>
            </div>
            <p class="project-description">
              Human resources management project for Japanese market with comprehensive employee lifecycle management.
            </p>
            <ul class="responsibility-list">
              <li>Maintained and refactored backend features post-MVP phase</li>
              <li>Collaborated on brainstorming and developing new features</li>
              <li>Worked with team of 5 on full-stack development</li>
            </ul>
            <div class="tech-stack-mini">
              <span>Node.js</span>
              <span>MySQL</span>
              <span>AWS</span>
              <span>Typescript</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Midas Protocol -->
      <div class="experience-item">
        <div class="experience-header">
          <div class="experience-company">
            <h3>Midas Protocol</h3>
          </div>
          <span class="experience-period">Jun 2019 - May 2020</span>
        </div>

        <div class="experience-role">
          <h4>Fresher Backend Developer</h4>
        </div>

        <div class="experience-projects">
          <div class="project-detail">
            <div class="project-header">
              <h5>Crypto Wallet & Exchange Platform</h5>
            </div>
            <p class="project-description">
              Crypto wallet application and exchange platform with real-time trading capabilities.
            </p>
            <ul class="responsibility-list">
              <li>Implemented <span class="keyword-highlight">APIs</span> using <span class="keyword-highlight">Loopback framework</span></li>
              <li>Developed and maintained <span class="keyword-highlight">real-time socket</span> backend using <span class="keyword-highlight">Socket.io</span></li>
              <li>Built <span class="keyword-highlight">RabbitMQ consumers</span> for <span class="keyword-highlight">asynchronous message processing</span></li>
            </ul>
            <div class="tech-stack-mini">
              <span>Microservice</span>
              <span>Loopback 3</span>
              <span>JavaScript</span>
              <span>RabbitMQ</span>
              <span>Socket.io</span>
              <span>Redis</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===============================================
     HERO SECTION
     =============================================== */
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-3xl);
    align-items: center;
    padding: 0 var(--spacing-3xl) var(--spacing-3xl);
    margin-top: -1rem;
    margin-bottom: var(--spacing-3xl);
    min-height: 80vh;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-content {
    animation: fadeIn 0.8s ease-out;
  }

  .hero-header-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    animation: slideInFromLeft 0.8s ease-out;
  }

  .hero-avatar {
    width: 150px;
    height: 150px;
    position: relative;
    animation: scaleIn 0.6s ease-out;
    flex-shrink: 0;
  }

  .hero-avatar::before {
    content: '';
    position: absolute;
    inset: -3px;
    background: var(--gradient-primary);
    border-radius: 50%;
    z-index: -1;
    animation: glow 3s ease-in-out infinite;
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-bg-primary);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transition: transform var(--transition-base);
  }

  .hero-avatar:hover img {
    transform: scale(1.05);
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .hero-role {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .hero-tagline {
    font-size: 0.9375rem;
    color: var(--color-text-tertiary);
    margin: 0;
    line-height: 1.5;
    font-style: italic;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: var(--color-primary);
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xl);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
  }

  [data-theme="dark"] .hero-badge {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text-primary);
  }

  .hero-subtitle {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
    line-height: 1.4;
  }

  .hero-description {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xl);
  max-width: 800px;
  text-align: left;
  white-space: pre-line;
}



.hero-description .highlight {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%);
  color: var(--color-primary);
  padding: 0.125rem 0.5rem;
  border-radius: var(--radius-md);
  font-weight: 600;
  border: 1px solid rgba(99, 102, 241, 0.2);
  transition: all var(--transition-fast);
  display: inline;
  box-decoration-break: clone; /* ✅ Key fix */
  -webkit-box-decoration-break: clone; /* Safari support */
  line-height: 1.6; /* reduce to avoid vertical clipping */
  cursor: pointer;
}


  .hero-description .highlight:hover {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.25) 0%, rgba(139, 92, 246, 0.25) 100%);
    border-color: rgba(99, 102, 241, 0.4);
    transform: translateY(-1px);
  }

.hero-description .highlight-alt {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.15) 0%, rgba(245, 158, 11, 0.15) 100%);
  color: var(--color-accent);
  padding: 0.125rem 0.5rem;
  border-radius: var(--radius-md);
  font-weight: 600;
  border: 1px solid rgba(236, 72, 153, 0.2);
  transition: all var(--transition-fast);
  display: inline; /* ✅ changed from inline-block */
  box-decoration-break: clone; /* ✅ ensures gradient + border clone across wrapped lines */
  -webkit-box-decoration-break: clone; /* ✅ Safari fix */
  line-height: 1.6; /* ✅ prevents vertical overlap */
  cursor: pointer;
}

  .hero-description .highlight-alt:hover {
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.25) 0%, rgba(245, 158, 11, 0.25) 100%);
    border-color: rgba(236, 72, 153, 0.4);
    transform: translateY(-1px);
  }

  .hero-description .highlight-orange {
    background: linear-gradient(135deg, rgba(245, 155, 66, 0.15) 0%, rgba(245, 155, 66, 0.15) 100%);
    color: #c2410c;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    border: 1px solid rgba(245, 155, 66, 0.3);
    transition: all var(--transition-fast);
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    line-height: 1.6;
    cursor: pointer;
  }

  .hero-description .highlight-orange:hover {
    background: linear-gradient(135deg, rgba(245, 155, 66, 0.25) 0%, rgba(245, 155, 66, 0.25) 100%);
    border-color: rgba(245, 155, 66, 0.5);
    transform: translateY(-1px);
  }

  .hero-description .highlight-green {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(5, 150, 105, 0.15) 100%);
    color: #047857;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    border: 1px solid rgba(5, 150, 105, 0.2);
    transition: all var(--transition-fast);
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    line-height: 1.6;
    cursor: pointer;
  }

  .hero-description .highlight-green:hover {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(5, 150, 105, 0.25) 100%);
    border-color: rgba(5, 150, 105, 0.4);
    transform: translateY(-1px);
  }

  [data-theme="dark"] .hero-description .highlight {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);
    border-color: rgba(99, 102, 241, 0.3);
  }

  [data-theme="dark"] .hero-description .highlight:hover {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.35) 0%, rgba(139, 92, 246, 0.35) 100%);
    border-color: rgba(99, 102, 241, 0.5);
  }

  [data-theme="dark"] .hero-description .highlight-alt {
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.2) 0%, rgba(245, 158, 11, 0.2) 100%);
    border-color: rgba(236, 72, 153, 0.3);
  }

  [data-theme="dark"] .hero-description .highlight-alt:hover {
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.35) 0%, rgba(245, 158, 11, 0.35) 100%);
    border-color: rgba(236, 72, 153, 0.5);
  }

  [data-theme="dark"] .hero-description .highlight-orange {
    background: linear-gradient(135deg, rgba(245, 155, 66, 0.2) 0%, rgba(245, 155, 66, 0.2) 100%);
    border-color: rgba(245, 155, 66, 0.3);
    color: #fdba74;
  }

  [data-theme="dark"] .hero-description .highlight-orange:hover {
    background: linear-gradient(135deg, rgba(245, 155, 66, 0.3) 0%, rgba(245, 155, 66, 0.3) 100%);
    border-color: rgba(245, 155, 66, 0.5);
  }

  [data-theme="dark"] .hero-description .highlight-green {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(5, 150, 105, 0.2) 100%);
    border-color: rgba(5, 150, 105, 0.3);
    color: #34d399;
  }

  [data-theme="dark"] .hero-description .highlight-green:hover {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.35) 0%, rgba(5, 150, 105, 0.35) 100%);
    border-color: rgba(5, 150, 105, 0.5);
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    margin-top: var(--spacing-xl);
  }

  .btn-large {
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
  }

  .hero-social {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: nowrap;
    align-items: center;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
    backdrop-filter: blur(10px);
    border: 2px solid transparent;
    border-radius: 50%;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .social-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--transition-fast);
    border-radius: 50%;
  }

  .social-link:hover::before {
    opacity: 0.15;
  }

  [data-theme="dark"] .social-link {
    background: linear-gradient(135deg, rgba(51, 65, 85, 0.9) 0%, rgba(30, 41, 59, 0.9) 100%);
  }

  .social-link i {
    font-size: 1.25rem;
    transition: transform var(--transition-fast);
    position: relative;
    z-index: 1;
  }

  .social-link:hover i {
    transform: scale(1.15) rotate(5deg);
  }

  /* GitHub - Dark theme */
  .social-link:nth-child(1) i {
    color: #24292f;
  }

  .social-link:nth-child(1):hover {
    border-color: #24292f;
    box-shadow: 0 4px 16px rgba(36, 41, 47, 0.3);
    transform: translateY(-2px);
  }

  [data-theme="dark"] .social-link:nth-child(1) i {
    color: #f0f6fc;
  }

  /* LinkedIn - Blue theme */
  .social-link:nth-child(2) i {
    color: #0a66c2;
  }

  .social-link:nth-child(2):hover {
    border-color: #0a66c2;
    box-shadow: 0 4px 16px rgba(10, 102, 194, 0.3);
    transform: translateY(-2px);
  }

  /* Gmail - Red theme */
  .social-link:nth-child(3) i {
    color: #ea4335;
  }

  .social-link:nth-child(3):hover {
    border-color: #ea4335;
    box-shadow: 0 4px 16px rgba(234, 67, 53, 0.3);
