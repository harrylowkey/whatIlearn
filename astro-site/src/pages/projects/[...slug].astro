---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

// Get other projects for sidebar
const allProjects = await getCollection('projects');
const otherProjects = allProjects
  .filter(p => p.slug !== project.slug)
  .sort((a, b) => {
    if (a.data.date && b.data.date) {
      return b.data.date.getTime() - a.data.date.getTime();
    }
    return 0;
  })
  .slice(0, 5);
---

<PageLayout
  title={`${project.data.title} - Harry Dang`}
  description={project.data.description}
  activeTab="projects"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/project.css" />
  </Fragment>

  <article class="project-content">
    <header class="mb-4">
      <h1 class="display-6">{project.data.title}</h1>

      {project.data.description && (
        <p class="lead text-muted">{project.data.description}</p>
      )}

      <div class="row mt-4">
        {project.data.date && (
          <div class="col-md-6 mb-3">
            <p class="mb-0">
              <strong><i class="mdi mdi-calendar me-2"></i>Date:</strong>
              <span class="text-muted ms-2">
                {project.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                })}
              </span>
            </p>
          </div>
        )}

        {project.data.role && (
          <div class="col-md-6 mb-3">
            <p class="mb-0">
              <strong><i class="mdi mdi-account-outline me-2"></i>Role:</strong>
              <span class="text-muted ms-2">{project.data.role}</span>
            </p>
          </div>
        )}

        {project.data.company && (
          <div class="col-md-6 mb-3">
            <p class="mb-0">
              <strong><i class="mdi mdi-office-building me-2"></i>Company:</strong>
              <span class="text-muted ms-2">{project.data.company}</span>
            </p>
          </div>
        )}
      </div>

      {project.data.technologies && project.data.technologies.length > 0 && (
        <div class="mt-4">
          <strong>Technologies:</strong>
          <div class="mt-2">
            {project.data.technologies.map((tech) => (
              <span class="badge bg-primary me-1 mb-1">{tech}</span>
            ))}
          </div>
        </div>
      )}

      {project.data.tags && project.data.tags.length > 0 && (
        <div class="mt-3">
          {project.data.tags.map((tag) => (
            <span class="badge bg-secondary me-1">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <hr />

    <div class="content-body mt-4">
      <Content />
    </div>

    <footer class="mt-5 pt-4 border-top">
      <a href="/projects" class="btn btn-outline-primary">
        <i class="mdi mdi-arrow-left me-1"></i>
        Back to Projects
      </a>
    </footer>
  </article>

  <div slot="sidebar">
    {otherProjects.length > 0 && (
      <div class="card mt-5">
        <div class="card-body">
          <h5 class="card-title">Other Projects</h5>
          <ul class="list-unstyled mt-3">
            {otherProjects.map((otherProject) => (
              <li class="mb-3">
                <a href={`/projects/${otherProject.slug}`} class="text-decoration-none">
                  {otherProject.data.title}
                </a>
                {otherProject.data.date && (
                  <div class="text-muted small">
                    {otherProject.data.date.toLocaleDateString('en-US', {
                      month: 'short',
                      year: 'numeric',
                    })}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </div>
</PageLayout>

<style>
  .project-content {
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .content-body :global(h2),
  .content-body :global(h3),
  .content-body :global(h4) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .content-body :global(ul) {
    list-style-type: none;
    padding-left: 0;
  }

  .content-body :global(ul li) {
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .content-body :global(ul li::before) {
    content: '✓';
    position: absolute;
    left: 0;
    color: #198754;
    font-weight: bold;
  }

  .content-body :global(strong) {
    font-weight: 600;
  }

  .content-body :global(p) {
    margin-bottom: 1rem;
  }
</style>
