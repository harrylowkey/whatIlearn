---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');

// Sort projects by date (newest first)
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.date && b.data.date) {
    return b.data.date.getTime() - a.data.date.getTime();
  }
  if (a.data.date) return -1;
  if (b.data.date) return 1;
  return a.data.title.localeCompare(b.data.title);
});

// Group projects by year
const projectsByYear = sortedProjects.reduce((acc, project) => {
  const year = project.data.date ? project.data.date.getFullYear() : 'Undated';
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(project);
  return acc;
}, {} as Record<string, typeof sortedProjects>);

// Sort years descending
const years = Object.keys(projectsByYear).sort((a, b) => {
  if (a === 'Undated') return 1;
  if (b === 'Undated') return -1;
  return Number(b) - Number(a);
});

const totalProjects = sortedProjects.length;

// Extract all unique technologies (case-insensitive)
const allTechnologies = [...new Set(
  allProjects.flatMap(p =>
    (p.data.technologies || []).map(tech => tech.toLowerCase())
  )
)].sort();
---

<BaseLayout
  title="Projects - Harry Dang"
  description="My portfolio of projects"
  fullWidth={true}
>
  <main class="projects-main">
    <!-- Animated Background -->
    <div class="animated-bg">
      <div class="bg-gradient-1"></div>
      <div class="bg-gradient-2"></div>
      <div class="bg-gradient-3"></div>
    </div>

    <!-- Hero Section -->
    <section class="projects-hero">
      <!-- Floating Project Previews -->
      <div class="floating-previews">
        {sortedProjects.slice(0, 10).map((project, index) => (
          <a href={`/projects/${project.slug}`} class={`preview-card preview-${index + 1}`}>
            <div class="preview-image">
              {project.data.cover ? (
                <img src={project.data.cover} alt={project.data.title} />
              ) : (
                <div class="preview-placeholder">
                  <i class="mdi mdi-code-braces-box"></i>
                </div>
              )}
            </div>
            <div class="preview-info">
              <h4 class="preview-title">{project.data.title}</h4>
              {project.data.technologies && project.data.technologies.length > 0 && (
                <div class="preview-techs">
                  {project.data.technologies.slice(0, 2).map((tech) => (
                    <span class="preview-tech-tag">{tech}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      <div class="hero-content-wrapper">
          <h1 class="hero-title-projects">
            My <span class="text-gradient">Projects</span>
          </h1>
          <p class="hero-description-projects">
                        A timeline journey through 10+ projects showcasing my expertise in <br /> backend development,
            cloud infrastructure and scalable system architecture
          </p>

          <div class="hero-stats-grid">
            <div class="stat-card">
              <div class="stat-icon">
                <i class="mdi mdi-briefcase-check"></i>
              </div>
              <div class="stat-content">
                <div class="stat-number">10+</div>
                <div class="stat-label">Total Projects</div>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">
                <i class="mdi mdi-calendar-range"></i>
              </div>
              <div class="stat-content">
                <div class="stat-number">5+</div>
                <div class="stat-label">Years</div>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">
                <i class="mdi mdi-code-braces"></i>
              </div>
              <div class="stat-content">
                <div class="stat-number">20+</div>
                <div class="stat-label">Technologies</div>
              </div>
            </div>
            
          </div>
        </div>
    </section>

    <div class="projects-container">
      <!-- Filter Section -->
      <section class="filter-section">
        <div class="filter-content">
          <div class="filter-header">
            <div class="filter-title-wrapper">
              <i class="mdi mdi-filter-variant"></i>
              <h3>Filter By Techs</h3>
            </div>
            <button class="filter-reset" id="resetFilter">
              <i class="mdi mdi-refresh"></i>
              <span>Reset</span>
            </button>
          </div>
          <div class="filter-buttons" id="filterButtons">
            <button class="filter-btn active" data-filter="all">
              <i class="mdi mdi-view-grid"></i>
              <span>All</span>
              <span class="filter-count">10+</span>
            </button>
            {allTechnologies.map((tech) => (
              <button class="filter-btn" data-filter={tech}>
                <span>{tech}</span>
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- Year Navigation -->
      <div class="year-nav-sticky" id="yearNav">
        <div class="year-nav-content">
          {years.map((year) => (
            <button class="year-nav-btn" data-year={year}>
              {year}
            </button>
          ))}
        </div>
      </div>

      <!-- Timeline View -->
      <section class="timeline-section">
        {years.map((year, yearIndex) => (
          <div class="year-section" id={`year-${year}`} data-year={year}>
            <div class="year-header">
              <div class="year-marker">
                <div class="year-dot"></div>
                {yearIndex !== years.length - 1 && <div class="year-line"></div>}
              </div>
              <div class="year-title-wrapper">
                <h2 class="year-title">{year}</h2>
                <span class="year-count">{projectsByYear[year].length} Project{projectsByYear[year].length !== 1 ? 's' : ''}</span>
              </div>
            </div>

            <div class="projects-grid">
              {projectsByYear[year].map((project) => (
                <article class="project-card-grid" data-technologies={JSON.stringify(project.data.technologies || [])}>
                  <a href={`/projects/${project.slug}`} class="project-card-link">
                    <div class="project-cover">
                      {project.data.cover ? (
                        <img src={project.data.cover} alt={project.data.title} />
                      ) : (
                        <div class="project-cover-placeholder">
                          <i class="mdi mdi-code-braces-box"></i>
                        </div>
                      )}
                      <div class="project-overlay">
                        <i class="mdi mdi-arrow-right-circle"></i>
                      </div>
                    </div>

                    <div class="project-content">
                      <div class="project-meta-top">
                        {project.data.status && (
                          <div class={`project-status-badge status-${project.data.status.toLowerCase()}`}>
                            <i class={`mdi ${project.data.status.toLowerCase() === 'maintain' ? 'mdi-cog-sync' : project.data.status.toLowerCase() === 'completed' ? 'mdi-check-circle' : 'mdi-progress-clock'}`}></i>
                            <span>{project.data.status.toLowerCase() === 'maintain' ? 'Ongoing' : project.data.status}</span>
                          </div>
                        )}
                        {project.data.date && (
                          <div class="project-date-small">
                            <i class="mdi mdi-calendar"></i>
                            <span>
                              {project.data.date.toLocaleDateString('en-US', {
                                month: 'short',
                                year: 'numeric',
                              })}
                            </span>
                          </div>
                        )}
                      </div>

                      <div class="project-info-wrapper">
                        <h3 class="project-title-grid">{project.data.title}</h3>

                        {project.data.description && (
                          <p class="project-description-grid">{project.data.description}</p>
                        )}

                        {project.data.technologies && project.data.technologies.length > 0 && (
                          <div class="project-technologies-grid">
                            {project.data.technologies.slice(0, 3).map((tech) => (
                              <span class="tech-tag-small">{tech}</span>
                            ))}
                            {project.data.technologies.length > 3 && (
                              <span class="tech-tag-more">+{project.data.technologies.length - 3}</span>
                            )}
                          </div>
                        )}
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>
    </div>
  </main>
</BaseLayout>

<script>
    // Track view count (hidden - no display)
    async function trackPageView() {
      try {
        await fetch('/api/views/projects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
      } catch (error) {
        console.error('Error tracking view:', error);
      }
    }
    trackPageView();

    // Filter functionality with multiple technology selection
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card-grid');
    const yearSectionsForFilter = document.querySelectorAll('.year-section');
    const resetButton = document.getElementById('resetFilter');

    let selectedFilters = new Set(['all']);

    function updateFilter() {
      let visibleCount = 0;

      projectCards.forEach(card => {
        const technologies = JSON.parse(card.getAttribute('data-technologies') || '[]');
        const technologiesLower = technologies.map(t => t.toLowerCase());

        // If 'all' is selected or if the card has ALL of the selected technologies (case-insensitive)
        const matchesFilter = selectedFilters.has('all') ||
          Array.from(selectedFilters).every(tech => technologiesLower.includes(tech.toLowerCase()));

        if (matchesFilter) {
          card.style.display = '';
          card.style.animation = 'fadeInUp 0.5s ease-out';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Update the count on the "All" button
      const allButton = document.querySelector('.filter-btn[data-filter="all"]');
      const countSpan = allButton?.querySelector('.filter-count');
      if (countSpan) {
        countSpan.textContent = visibleCount.toString();
      }

      // Hide year sections with no visible projects and update counts
      yearSectionsForFilter.forEach(section => {
        const visibleProjectsInYear = section.querySelectorAll('.project-card-grid:not([style*="display: none"])');
        const yearCount = section.querySelector('.year-count');

        if (visibleProjectsInYear.length === 0) {
          section.style.display = 'none';
        } else {
          section.style.display = '';
          // Update the year count
          if (yearCount) {
            const count = visibleProjectsInYear.length;
            yearCount.textContent = `${count} Project${count !== 1 ? 's' : ''}`;
          }
        }
      });
    }

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');

        if (filter === 'all') {
          // Reset to 'all'
          selectedFilters.clear();
          selectedFilters.add('all');
          filterButtons.forEach(btn => btn.classList.remove('active'));
          button.classList.add('active');
        } else {
          // Remove 'all' if a specific tech is selected
          selectedFilters.delete('all');

          // Toggle the filter
          if (selectedFilters.has(filter)) {
            selectedFilters.delete(filter);
            button.classList.remove('active');

            // If no filters selected, reset to 'all'
            if (selectedFilters.size === 0) {
              selectedFilters.add('all');
              filterButtons[0]?.classList.add('active');
            }
          } else {
            selectedFilters.add(filter);
            button.classList.add('active');
            // Remove 'all' active state
            filterButtons[0]?.classList.remove('active');
          }
        }

        updateFilter();
      });
    });

    resetButton?.addEventListener('click', () => {
      selectedFilters.clear();
      selectedFilters.add('all');
      filterButtons.forEach(btn => btn.classList.remove('active'));
      filterButtons[0]?.classList.add('active');
      updateFilter();
    });

    // Year navigation scroll spy and click handlers
    const yearNavButtons = document.querySelectorAll('.year-nav-btn');
    const yearSections = document.querySelectorAll('.year-section');

    // Smooth scroll to year
    yearNavButtons.forEach(button => {
      button.addEventListener('click', () => {
        const year = button.getAttribute('data-year');
        const section = document.getElementById(`year-${year}`);
        if (section) {
          const navHeight = document.querySelector('.projects-nav')?.offsetHeight || 0;
          const yearNavHeight = document.querySelector('.year-nav-sticky')?.offsetHeight || 0;
          const offset = navHeight + yearNavHeight + 20;

          const elementPosition = section.getBoundingClientRect().top + window.pageYOffset;
          const offsetPosition = elementPosition - offset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      });
    });

    // Update active year on scroll
    const observerOptions = {
      threshold: 0.3,
      rootMargin: '-100px 0px -50% 0px'
    };

    const yearObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const year = entry.target.getAttribute('data-year');
          yearNavButtons.forEach(btn => {
            if (btn.getAttribute('data-year') === year) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          });
        }
      });
    }, observerOptions);

    yearSections.forEach(section => {
      yearObserver.observe(section);
    });

    // Scroll animations for project cards
    const cardObserverOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, cardObserverOptions);

    document.querySelectorAll('.project-card-grid, .stat-card, .filter-section').forEach(el => {
      cardObserver.observe(el);
    });
</script>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --color-bg: #ffffff;
    --color-surface: #f8fafc;
    --color-text-primary: #0f172a;
    --color-text-secondary: #475569;
    --color-text-tertiary: #64748b;
    --color-border: #e2e8f0;
    --color-primary: #6366f1;
    --color-primary-light: #e0e7ff;
    --color-accent: #ec4899;
    --gradient-primary: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    --gradient-accent: linear-gradient(135deg, #ec4899 0%, #f59e0b 100%);
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1);
  }

  [data-theme="dark"] {
    --color-bg: #0f172a;
    --color-surface: #1e293b;
    --color-text-primary: #f1f5f9;
    --color-text-secondary: #cbd5e1;
    --color-text-tertiary: #94a3b8;
    --color-border: #334155;
    --color-primary: #818cf8;
    --color-primary-light: #312e81;
  }

  /* Main Content */
  .projects-main {
    position: relative;
    min-height: calc(100vh - 80px);
    padding: 2rem 0;
  }

  /* Animated Background */
  .animated-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .bg-gradient-1,
  .bg-gradient-2,
  .bg-gradient-3 {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    animation: float 20s ease-in-out infinite;
  }

  .bg-gradient-1 {
    width: 600px;
    height: 600px;
    background: var(--gradient-primary);
    top: -200px;
    right: -200px;
    animation-delay: 0s;
  }

  .bg-gradient-2 {
    width: 500px;
    height: 500px;
    background: var(--gradient-accent);
    bottom: -150px;
    left: -150px;
    animation-delay: 7s;
  }

  .bg-gradient-3 {
    width: 400px;
    height: 400px;
    background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: 14s;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(100px, -100px) scale(1.1);
    }
    66% {
      transform: translate(-100px, 100px) scale(0.9);
    }
  }

  /* Container */
  .projects-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Hero Section */
  .projects-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    margin-bottom: 0;
    opacity: 0;
    animation: fadeInUp 0.8s ease-out 0.2s forwards;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  /* Floating Project Previews */
  .floating-previews {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .preview-card {
    position: absolute;
    width: 240px;
    height: 160px;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255, 255, 255, 0.2);
    text-decoration: none;
    color: inherit;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.95);
    opacity: 0.2;
  }

  [data-theme="dark"] .preview-card {
    background: rgba(30, 41, 59, 0.95);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .preview-card:hover {
    transform: scale(1.15) translateY(-10px) !important;
    opacity: 1 !important;
    z-index: 1000;
    box-shadow: 0 20px 60px rgba(99, 102, 241, 0.5);
    border-color: var(--color-primary);
    animation-play-state: paused !important;
  }

  .preview-image {
    width: 100%;
    height: 100px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .preview-card:hover .preview-image img {
    transform: scale(1.1);
  }

  .preview-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(139, 92, 246, 0.3) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preview-placeholder i {
    font-size: 2rem;
    color: var(--color-primary);
  }

  .preview-info {
    padding: 0.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .preview-title {
    font-size: 0.875rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .preview-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .preview-tech-tag {
    padding: 0.125rem 0.375rem;
    background: var(--color-primary-light);
    border: 1px solid var(--color-primary);
    border-radius: 0.25rem;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Positioning and animations for each preview card */
  .preview-1 {
    top: 5%;
    left: 8%;
    animation: float1 15s ease-in-out infinite;
  }

  .preview-2 {
    top: 5%;
    right: 8%;
    animation: float2 18s ease-in-out infinite;
  }

  .preview-3 {
    top: 30%;
    left: 2%;
    animation: float3 20s ease-in-out infinite;
  }

  .preview-4 {
    top: 30%;
    right: 2%;
    animation: float4 16s ease-in-out infinite;
  }

  .preview-5 {
    bottom: 5%;
    left: 8%;
    animation: float5 22s ease-in-out infinite;
  }

  .preview-6 {
    bottom: 5%;
    right: 8%;
    animation: float6 19s ease-in-out infinite;
  }

  .preview-7 {
    top: 50%;
    left: 2%;
    animation: float7 17s ease-in-out infinite;
  }

  .preview-8 {
    top: 50%;
    right: 2%;
    animation: float8 21s ease-in-out infinite;
  }

  .preview-9 {
    top: 80%;
    left: 40%;
    transform: translate(-10%, -10%);
    animation: float9 23s ease-in-out infinite;
  }

  .preview-10 {
    bottom: 80%;
    left: 40%;
    transform: translate(-50%, 50%);
    animation: float10 24s ease-in-out infinite;
  }

  @keyframes float1 {
    0%, 100% {
      transform: translate(0, 0) rotate(-5deg);
    }
    50% {
      transform: translate(20px, -30px) rotate(5deg);
    }
  }

  @keyframes float2 {
    0%, 100% {
      transform: translate(0, 0) rotate(5deg);
    }
    50% {
      transform: translate(-25px, 25px) rotate(-3deg);
    }
  }

  @keyframes float3 {
    0%, 100% {
      transform: translate(0, 0) rotate(3deg);
    }
    50% {
      transform: translate(30px, 20px) rotate(-5deg);
    }
  }

  @keyframes float4 {
    0%, 100% {
      transform: translate(0, 0) rotate(-3deg);
    }
    50% {
      transform: translate(-20px, -25px) rotate(4deg);
    }
  }

  @keyframes float5 {
    0%, 100% {
      transform: translate(0, 0) rotate(4deg);
    }
    50% {
      transform: translate(-20px, 25px) rotate(-6deg);
    }
  }

  @keyframes float6 {
    0%, 100% {
      transform: translate(0, 0) rotate(-4deg);
    }
    50% {
      transform: translate(-30px, -20px) rotate(5deg);
    }
  }

  @keyframes float7 {
    0%, 100% {
      transform: translate(0, 0) rotate(6deg);
    }
    50% {
      transform: translate(25px, -20px) rotate(-4deg);
    }
  }

  @keyframes float8 {
    0%, 100% {
      transform: translate(0, 0) rotate(-6deg);
    }
    50% {
      transform: translate(-25px, 20px) rotate(3deg);
    }
  }

  @keyframes float9 {
    0%, 100% {
      transform: translate(-10%, -10%) translate(0, 0) rotate(2deg);
    }
    50% {
      transform: translate(-10%, -10%) translate(30px, 25px) rotate(-5deg);
    }
  }

  @keyframes float10 {
    0%, 100% {
      transform: translate(0, 0) rotate(6deg);
    }
    50% {
      transform: translate(25px, -20px) rotate(-4deg);
    }
  }

  .hero-content-wrapper {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 10;
    pointer-events: auto;
  }

  .hero-content-wrapper * {
    pointer-events: auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--color-primary-light);
    border: 2px solid var(--color-primary);
    border-radius: 2rem;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    animation: pulse 2s ease-in-out infinite;
  }

  .hero-badge i {
    font-size: 1.125rem;
  }

  .hero-title-projects {
    font-size: 5rem;
