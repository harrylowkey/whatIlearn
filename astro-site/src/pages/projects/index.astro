---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const allProjects = await getCollection('projects');

// Sort projects by date (newest first)
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.date && b.data.date) {
    return b.data.date.getTime() - a.data.date.getTime();
  }
  if (a.data.date) return -1;
  if (b.data.date) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const totalProjects = sortedProjects.length;
---

<PageLayout
  title="Projects - Harry Dang"
  description="My portfolio of projects"
  activeTab="projects"
  fullWidth={true}
>
  <div class="projects-container">
    <!-- About Section Below Header -->
    <section class="about-section">
      <div class="about-content">
        <div class="about-icon">
          <i class="mdi mdi-information"></i>
        </div>
        <div class="about-text">
          <h3 class="about-title">About My Work</h3>
          <p class="about-description">
            Projects I've contributed to throughout my career. Specializing in backend development with Python, Node.js, databases, and DevOps.
          </p>
        </div>
        <div class="projects-count">
          <div class="count-number">{totalProjects}</div>
          <div class="count-label">Projects</div>
        </div>
      </div>
    </section>

    <div class="tab-pane show active">
      <div class="projects-header">
        <h2 class="projects-heading">All Projects</h2>
      </div>

    <div class="projects-grid">
      {sortedProjects.map((project) => (
        <article class="project-card-modern">
          <div class="project-card-header">
            <div class="project-main-info">
              <h3 class="project-title">
                <a href={`/projects/${project.slug}`}>
                  {project.data.title}
                </a>
              </h3>
              {project.data.role && (
                <div class="project-role">
                  <i class="mdi mdi-account-outline"></i>
                  <span>{project.data.role}</span>
                </div>
              )}
            </div>
            {project.data.date && (
              <div class="project-date">
                <i class="mdi mdi-calendar"></i>
                <span>
                  {project.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    year: 'numeric',
                  })}
                </span>
              </div>
            )}
          </div>

          {project.data.description && (
            <p class="project-description">{project.data.description}</p>
          )}

          {project.data.technologies && project.data.technologies.length > 0 && (
            <div class="project-technologies">
              <div class="tech-label">
                <i class="mdi mdi-code-tags"></i>
                <span>Tech Stack</span>
              </div>
              <div class="tech-tags-wrapper">
                {project.data.technologies.map((tech) => (
                  <span class="tech-tag-project">{tech}</span>
                ))}
              </div>
            </div>
          )}

          <div class="project-footer">
            {project.data.company && (
              <div class="project-company">
                <i class="mdi mdi-office-building"></i>
                <span>{project.data.company}</span>
              </div>
            )}
            <a href={`/projects/${project.slug}`} class="project-link-btn">
              <span>View Details</span>
              <i class="mdi mdi-arrow-right"></i>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
  </div>
</PageLayout>

<style>
  /* Projects Container - Centered with max width */
  .projects-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* About Section Below Header */
  .about-section {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.08);
    transition: all var(--transition-base);
  }

  .about-section:hover {
    box-shadow: 0 8px 30px rgba(99, 102, 241, 0.15);
  }

  [data-theme="dark"] .about-section {
    background: rgba(30, 41, 59, 0.9);
  }

  .about-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
    flex-wrap: wrap;
  }

  .about-icon {
    width: 48px;
    height: 48px;
    background: var(--gradient-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: white;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  .about-text {
    flex: 1;
    min-width: 250px;
  }

  .about-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.375rem;
  }

  .about-description {
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
    font-size: 0.9375rem;
  }

  .projects-count {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-md);
    background: rgba(99, 102, 241, 0.1);
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-primary);
    min-width: 90px;
  }

  .count-number {
    font-size: 2rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .count-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Projects Header */
  .projects-header {
    margin-bottom: var(--spacing-lg);
  }

  .projects-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    gap: var(--spacing-lg);
  }

  /* Project Card Modern */
  .project-card-modern {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-lg);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .project-card-modern::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.05), transparent);
    transition: left 0.5s ease;
  }

  .project-card-modern:hover::before {
    left: 100%;
  }

  .project-card-modern:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(99, 102, 241, 0.15);
    border-color: var(--color-primary);
  }

  [data-theme="dark"] .project-card-modern {
    background: rgba(30, 41, 59, 0.9);
  }

  [data-theme="dark"] .project-card-modern:hover {
    box-shadow: 0 12px 40px rgba(99, 102, 241, 0.3);
  }

  /* Project Card Header */
  .project-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    flex-wrap: wrap;
  }

  .project-main-info {
    flex: 1;
    min-width: 200px;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .project-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all var(--transition-fast);
    position: relative;
  }

  .project-title a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient-primary);
    transition: width var(--transition-base);
  }

  .project-title a:hover {
    color: var(--color-primary);
  }

  .project-title a:hover::after {
    width: 100%;
  }

  .project-role {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .project-role i {
    font-size: 0.9375rem;
  }

  .project-date {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .project-date i {
    font-size: 1rem;
    color: var(--color-primary);
  }

  /* Project Description */
  .project-description {
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--spacing-md);
    font-size: 0.9375rem;
  }

  /* Project Technologies */
  .project-technologies {
    margin-bottom: var(--spacing-md);
  }

  .tech-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .tech-label i {
    font-size: 1rem;
    color: var(--color-primary);
  }

  .tech-tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tech-tag-project {
    padding: 0.25rem 0.75rem;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
    transition: all var(--transition-fast);
    cursor: default;
  }

  .tech-tag-project:hover {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  [data-theme="dark"] .tech-tag-project {
    background: rgba(30, 41, 59, 0.8);
  }

  /* Project Footer */
  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-sm);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .project-company {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .project-company i {
    font-size: 1rem;
    color: var(--color-primary);
  }

  .project-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    background: var(--gradient-primary);
    color: white;
    border-radius: var(--radius-lg);
    font-weight: 600;
    font-size: 0.8125rem;
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    position: relative;
    overflow: hidden;
  }

  .project-link-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s ease, height 0.6s ease;
  }

  .project-link-btn:hover::before {
    width: 300px;
    height: 300px;
  }

  .project-link-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
    color: white;
  }

  .project-link-btn i {
    font-size: 1rem;
    transition: transform var(--transition-fast);
  }

  .project-link-btn:hover i {
    transform: translateX(4px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .projects-container {
      max-width: 100%;
    }

    .about-content {
      flex-direction: column;
      text-align: center;
    }

    .about-icon {
      margin: 0 auto;
    }

    .about-text {
      min-width: auto;
    }

    .projects-count {
      width: 100%;
    }

    .projects-heading {
      font-size: 1.25rem;
    }

    .project-card-header {
      flex-direction: column;
    }

    .project-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .project-link-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 576px) {
    .about-section {
      padding: var(--spacing-md);
    }

    .project-card-modern {
      padding: var(--spacing-md);
    }

    .project-title {
      font-size: 1.125rem;
    }

    .count-number {
      font-size: 1.75rem;
    }
  }
</style>
