---
interface Props {
  activeTab?: 'projects' | 'tasks' | 'notes';
}

const { activeTab } = Astro.props;
const webUrl = import.meta.env.PUBLIC_WEB_URL || '';
---

<header class="modern-header">
  <div class="header-content">
    <!-- Profile Section -->
    <div class="profile-section">
      <div class="avatar-wrapper">
        <img
          src="https://img.freepik.com/free-vector/cute-astronaut-working-laptop-cartoon-vector-icon-illustration-science-technology-icon-isolated_138676-4634.jpg?w=900&t=st=1710698177~exp=1710698777~hmac=6dcee222fbb754582fe608807f348cca60803839d5d6f4d317aaae883902f3e5"
          class="avatar"
          alt="Harry Dang"
        />
        <div class="avatar-status"></div>
      </div>
      <div class="profile-info">
        <h1 class="profile-name">Harry Dang</h1>
        <p class="profile-role">Backend Developer</p>
        <p class="profile-bio">
          Fascinated by <span class="highlight">databases</span>, <span class="highlight">DevOps</span>, and <span class="highlight">Neovim</span>
        </p>
      </div>
    </div>

    <!-- Social Links -->
    <div class="social-links">
      <a
        href="mailto:harrydang.tech@gmail.com"
        class="social-link"
        title="Email"
      >
        <i class="mdi mdi-email-outline"></i>
        <span class="social-label">harrydang.tech@gmail.com</span>
      </a>
      <a
        href="https://github.com/harrylowkey"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        title="GitHub"
      >
        <i class="mdi mdi-github"></i>
        <span class="social-label">harrylowkey</span>
      </a>
      <a
        href="https://www.instagram.com/coding.easily/"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        title="Instagram"
      >
        <i class="mdi mdi-instagram"></i>
        <span class="social-label">coding.easily</span>
      </a>
    </div>

    <!-- Navigation Tabs -->
    <nav class="nav-tabs-modern" role="navigation">
      <a
        href={`${webUrl}/`}
        class={`nav-tab ${activeTab === 'tasks' ? 'active' : ''}`}
        aria-current={activeTab === 'tasks' ? 'page' : undefined}
      >
        <i class="mdi mdi-view-dashboard"></i>
        <span>Home</span>
      </a>
      <a
        href={`${webUrl}/projects`}
        class={`nav-tab ${activeTab === 'projects' ? 'active' : ''}`}
        aria-current={activeTab === 'projects' ? 'page' : undefined}
      >
        <i class="mdi mdi-briefcase"></i>
        <span>Projects</span>
      </a>
      <a
        href={`${webUrl}/notes`}
        class={`nav-tab ${activeTab === 'notes' ? 'active' : ''}`}
        aria-current={activeTab === 'notes' ? 'page' : undefined}
      >
        <i class="mdi mdi-book-open-variant"></i>
        <span>Notes</span>
      </a>

      <!-- Theme Toggle -->
      <button
        class="theme-toggle"
        onclick="window.toggleTheme()"
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <i class="mdi mdi-weather-sunny theme-icon-light"></i>
        <i class="mdi mdi-weather-night theme-icon-dark"></i>
      </button>
    </nav>
  </div>
</header>

<style>
  .modern-header {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-2xl);
    padding: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.1);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .modern-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.1), transparent);
    transition: left 0.5s ease;
  }

  .modern-header:hover::before {
    left: 100%;
  }

  .modern-header:hover {
    box-shadow: 0 8px 32px 0 rgba(99, 102, 241, 0.2);
    border-color: rgba(99, 102, 241, 0.3);
    transform: translateY(-2px);
  }

  [data-theme="dark"] .modern-header {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
  }

  [data-theme="dark"] .modern-header:hover {
    box-shadow: 0 8px 32px 0 rgba(99, 102, 241, 0.3);
    border-color: rgba(99, 102, 241, 0.4);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  /* Profile Section */
  .profile-section {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .avatar-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-primary);
    box-shadow: 0 0 0 4px var(--color-primary-light), 0 8px 16px rgba(99, 102, 241, 0.3);
    transition: all var(--transition-base);
  }

  .avatar:hover {
    transform: scale(1.05) rotate(5deg);
    box-shadow: 0 0 0 6px var(--color-primary-light), 0 12px 24px rgba(99, 102, 241, 0.4);
  }

  [data-theme="dark"] .avatar {
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2), 0 8px 16px rgba(99, 102, 241, 0.4);
  }

  [data-theme="dark"] .avatar:hover {
    box-shadow: 0 0 0 6px rgba(99, 102, 241, 0.3), 0 12px 24px rgba(99, 102, 241, 0.6);
  }

  .avatar-status {
    position: absolute;
    bottom: 5px;
    right: 5px;
    width: 16px;
    height: 16px;
    background: var(--color-success);
    border: 3px solid var(--color-bg-primary);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .profile-info {
    flex: 1;
  }

  .profile-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .profile-role {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .profile-bio {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .highlight {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Social Links */
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(248, 250, 252, 0.8);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    transition: all var(--transition-fast);
    position: relative;
    overflow: hidden;
  }

  .social-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.1), transparent);
    transition: left 0.3s ease;
  }

  .social-link:hover::before {
    left: 100%;
  }

  .social-link:hover {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
  }

  [data-theme="dark"] .social-link {
    background: rgba(30, 41, 59, 0.8);
  }

  [data-theme="dark"] .social-link:hover {
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
  }

  .social-link i {
    font-size: 1.25rem;
  }

  .social-label {
    font-weight: 500;
  }

  /* Navigation Tabs */
  .nav-tabs-modern {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background: var(--color-bg-secondary);
    padding: 0.5rem;
    border-radius: var(--radius-xl);
  }

  .nav-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: all var(--transition-fast);
    position: relative;
    overflow: hidden;
  }

  .nav-tab i {
    font-size: 1.25rem;
  }

  .nav-tab:hover {
    color: var(--color-primary);
    background: var(--color-bg-primary);
  }

  .nav-tab.active {
    background: var(--color-bg-primary);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .nav-tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-primary);
    border-radius: var(--radius-full);
  }

  /* Theme Toggle */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-left: auto;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: rotate(15deg);
  }

  .theme-icon-light,
  .theme-icon-dark {
    font-size: 1.25rem;
  }

  [data-theme="light"] .theme-icon-dark {
    display: none;
  }

  [data-theme="dark"] .theme-icon-light {
    display: none;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .modern-header {
      padding: var(--spacing-lg);
    }

    .profile-section {
      flex-direction: column;
      text-align: center;
    }

    .profile-name {
      font-size: 1.5rem;
    }

    .social-links {
      flex-direction: column;
      width: 100%;
    }

    .social-link {
      width: 100%;
      justify-content: center;
    }

    .nav-tabs-modern {
      flex-wrap: wrap;
    }

    .nav-tab span {
      display: none;
    }

    .nav-tab {
      flex: 1;
      justify-content: center;
      padding: 0.75rem;
    }

    .theme-toggle {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 576px) {
    .avatar {
      width: 80px;
      height: 80px;
    }

    .social-label {
      font-size: 0.8125rem;
    }
  }
</style>
