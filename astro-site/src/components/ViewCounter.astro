---
interface Props {
  pagePath: string;
  className?: string;
}

const { pagePath, className = '' } = Astro.props;
// Create unique ID for this counter instance
const counterId = `view-count-${pagePath.replace(/\//g, '-')}`;
---

<div class={`view-counter ${className}`} data-page-path={pagePath}>
  <i class="mdi mdi-eye-outline"></i>
  <span class="view-count-value" id={counterId}>0</span> views
</div>

<script define:vars={{ pagePath, counterId }}>
  // Track and display view count
  async function trackView() {
    const apiUrl = `/api/views/${pagePath}`;

    console.log('[ViewCounter] Tracking view for:', pagePath);
    console.log('[ViewCounter] API URL:', apiUrl);
    console.log('[ViewCounter] Counter ID:', counterId);

    try {
      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
      });

      console.log('[ViewCounter] Response status:', response.status);

      if (response.ok) {
        const data = await response.json();
        console.log('[ViewCounter] Response data:', data);

        const viewCountElement = document.getElementById(counterId);
        console.log('[ViewCounter] Element found:', viewCountElement);

        if (viewCountElement && data.views !== undefined) {
          viewCountElement.textContent = data.views.toLocaleString();
          console.log('[ViewCounter] Updated count to:', data.views);
        }
      } else {
        console.error('[ViewCounter] Response not OK:', await response.text());
      }
    } catch (error) {
      console.error('[ViewCounter] Error tracking view:', error);
    }
  }

  // Track view when page loads
  console.log('[ViewCounter] Script loaded, ready state:', document.readyState);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', trackView);
  } else {
    trackView();
  }
</script>

<style>
  .view-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-tertiary);
    padding: 0.25rem 0.75rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 1rem;
    transition: all 0.3s ease;
  }

  [data-theme="dark"] .view-counter {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .view-counter i {
    font-size: 1rem;
    color: var(--color-primary);
  }
</style>
