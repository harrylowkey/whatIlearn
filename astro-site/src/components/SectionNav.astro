---
// Section Navigation Component
---

<nav class="section-nav" aria-label="Page sections navigation">
  <div class="section-nav-timeline">
    <ul class="section-nav-list">
      <li>
        <a href="#hero" class="section-nav-item active" data-section="hero">
          <span class="nav-dot"></span>
          <span class="nav-label">Home</span>
        </a>
      </li>
      <li>
        <a href="#experience" class="section-nav-item" data-section="experience">
          <span class="nav-dot"></span>
          <span class="nav-label">Experience</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .section-nav {
    position: fixed;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--z-fixed);
    animation: fadeIn 0.6s ease-out 0.5s both;
  }

  .section-nav-timeline {
    position: relative;
    padding-left: 1.5rem;
  }

  /* Vertical line matching experience timeline */
  .section-nav-timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    border-radius: var(--radius-full);
  }

  .section-nav-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .section-nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: all var(--transition-fast);
    position: relative;
  }

  /* Dot matching experience timeline */
  .nav-dot {
    position: absolute;
    left: calc(-1.5rem - 6px);
    width: 15px;
    height: 15px;
    background: var(--color-bg-secondary);
    border: 3px solid var(--color-text-secondary);
    border-radius: 50%;
    transition: all var(--transition-fast);
    flex-shrink: 0;
    z-index: 1;
  }

  [data-theme="dark"] .nav-dot {
    background: var(--color-bg-primary);
    border-color: var(--color-text-secondary);
  }

  .nav-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  /* Hover state */
  .section-nav-item:hover .nav-label {
    color: var(--color-primary);
    transform: translateX(2px);
  }

  .section-nav-item:hover .nav-dot {
    border-color: var(--color-primary);
    transform: scale(1.3);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  /* Active state matching experience timeline */
  .section-nav-item.active .nav-dot {
    background: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .section-nav-item.active .nav-label {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-primary);
  }

  [data-theme="dark"] .section-nav-item.active .nav-dot {
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3);
  }

  [data-theme="dark"] .section-nav-item.active .nav-label {
    color: #a5b4fc;
  }

  [data-theme="dark"] .section-nav-item:hover .nav-label {
    color: #a5b4fc;
  }

  [data-theme="dark"] .section-nav-item:hover .nav-dot {
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .section-nav {
      right: 1rem;
    }
  }

  @media (max-width: 768px) {
    .section-nav {
      right: 0.5rem;
    }

    .section-nav-timeline {
      padding-left: 1rem;
    }

    .nav-dot {
      left: calc(-1rem - 6px);
      width: 12px;
      height: 12px;
      border-width: 2px;
    }

    .section-nav-list {
      gap: 1.5rem;
    }

    .nav-label {
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  // Smooth scroll behavior
  document.querySelectorAll('.section-nav-item').forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = item.getAttribute('href');
      const targetSection = document.querySelector(targetId);

      if (targetSection) {
        targetSection.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Update active state on scroll
  const sections = document.querySelectorAll('section[id]');
  const navItems = document.querySelectorAll('.section-nav-item');

  function updateActiveSection() {
    const scrollPosition = window.scrollY + 200;

    sections.forEach(section => {
      const sectionTop = section.offsetTop;
      const sectionHeight = section.offsetHeight;
      const sectionId = section.getAttribute('id');

      if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
        navItems.forEach(item => {
          item.classList.remove('active');
          if (item.getAttribute('data-section') === sectionId) {
            item.classList.add('active');
          }
        });
      }
    });
  }

  window.addEventListener('scroll', updateActiveSection);
  updateActiveSection();
</script>
